{
  "name": "cat-script",
  "version": "0.1.0",
  "description": "Browser-based American Express transaction categorizer",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "start": "node server/index.js",
    "build": "npm --prefix client run build",
    "install:client": "npm --prefix client install",
    "cli": "node index.js"
  },
  "bin": {
    "amexcat": "index.js"
  },
  "author": "Korey Stanley",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "csv": "^5.1.3",
    "csv-parse": "^6.1.0",
    "currency.js": "^1.2.2",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "chalk": "^2.4.2",
    "clear": "^0.1.0",
    "cli-table3": "^0.5.1",
    "commander": "^3.0.2",
    "inquirer": "^8.2.6",
    "html-pdf": "^3.0.1",
    "money-math": "^2.5.1",
    "progress": "^2.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
